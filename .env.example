# --- Local LLM (LM Studio, Ollama, etc.) ---
# Point at your OpenAI-compatible local server. Any placeholder key is fine.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
# Optional: set the loaded model id. Leave blank to auto-detect from the server.
OPENAI_MODEL=

# --- Cloud OpenAI (comment out OPENAI_BASE_URL above) ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4.1-mini
